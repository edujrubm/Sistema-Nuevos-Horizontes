NODE_ENV=development
PORT=3000

# PostgreSQL: el esquema y las migraciones SQL siguen siendo la fuente de verdad.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=new_horizons
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_SSL=false

# Persona 3: SOLO laboratorio local, actor sintético del servidor.
P3_TEST_ACTOR_ID=1
P3_DRAFT_STATE=P3_BORRADOR
P3_CONFIRMED_STATE=P3_CONFIRMADO

# Contexto local de evolución e historial; sustituir por sesión en el siguiente ciclo.
P3_TEST_AREA=Legal
P3_TEST_ROLE=COORDINACION
# Directorio privado de PDF, ignorado por Git y fuera de public/.
P3_DOCUMENTS_DIR=test-results/documentos-privados
