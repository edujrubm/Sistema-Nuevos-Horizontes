NODE_ENV=development
PORT=3000

# PostgreSQL: el esquema y las migraciones SQL siguen siendo la fuente de verdad.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=new_horizons
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_SSL=false

# módulos de área: SOLO laboratorio local, actor sintético del servidor.
AUDIT_ACTOR_USERNAME=

# Contexto local de evolución e historial; sustituir por sesión en el siguiente ciclo.
AREA_TEST_NOMBRE=Legal
AREA_TEST_ROL=COORDINACION
# Directorio privado de PDF, ignorado por Git y fuera de public/.
DOCUMENTOS_DIR=test-results/documentos-privados

# Deben coincidir con los códigos aprobados en estado_formulario.
FORM_DRAFT_STATE_CODE=BORRADOR
FORM_CONFIRMED_STATE_CODE=CONFIRMADO
FORM_DISCARDED_STATE_CODE=DESCARTADO
