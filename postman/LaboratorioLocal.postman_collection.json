{
  "info": {
    "name": "Laboratorio local - endpoints experimentales",
    "description": "Elegir área al iniciar el servidor. Los cambios requieren versión y motivo; usar los cuerpos de docs/local/GUIA_LOCAL.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3015/api/v1"
    },
    {
      "key": "id",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "GET /laboratorio/catalogos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/laboratorio/catalogos"
      }
    },
    {
      "name": "GET /laboratorio/fichas/{id}",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/laboratorio/fichas/{{id}}"
      }
    },
    {
      "name": "PATCH /laboratorio/fichas/{id}",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/laboratorio/fichas/{{id}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"version\": 1,\n  \"motivo\": \"Prueba local\"\n}"
        }
      }
    },
