{
  "info": {
    "name": "Persona 3 - Contrato de errores",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3003/api/v1"
    }
  ],
  "item": [
    {
      "name": "Identificador inválido",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/legal/beneficiarias/letras/fichas"
      }
    },
    {
      "name": "Ruta inexistente",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ruta-inexistente"
      }
    },
    {
      "name": "JSON mal formado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/legal/beneficiarias/100/referencias",
        "body": {
          "mode": "raw",
          "raw": "{\"incompleto\":"
        }
      }
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test('Error con cinco propiedades',()=>pm.expect(Object.keys(pm.response.json()).sort()).to.eql(['estado','codigo','mensaje','errores','idSolicitud'].sort()));",
          "pm.test('Estado e identificador consistentes',()=>{const d=pm.response.json();pm.expect(d.estado).to.eql(pm.response.code);pm.expect(d.idSolicitud).to.eql(pm.response.headers.get('X-Id-Solicitud'));});"
        ]
      }
    }
  ]
}