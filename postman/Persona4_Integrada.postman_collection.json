{
  "info": {
    "name": "Persona4 - Albergue y Documentos integrados",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solo entorno local sintético. Ejecutar desde la raíz del repositorio. No usa producción. Flujo de carga directa unificado; no existen solicitar/completar ficticios."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3017/api/v1"
    },
    {
      "key": "beneficiariaId",
      "value": "100"
    },
    {
      "key": "beneficiariaAlbergueId",
      "value": "200"
    },
    {
      "key": "formularioId",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "01 Contexto documental",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/beneficiarias/{{beneficiariaId}}/documentos/contexto"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200',()=>pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON',()=>pm.response.to.be.json);",
              "pm.test('Área y fichas autorizadas',()=>{const d=pm.response.json();pm.expect(d.area).to.eql('Legal');pm.expect(d.formularios.some(f=>f.id===pm.collectionVariables.get('formularioId'))).to.eql(true)});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Cargar PDF directo",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/beneficiarias/{{beneficiariaId}}/documentos/cargas",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "formularioId",
              "value": "{{formularioId}}",
              "type": "text"
            },
            {
              "key": "categoria",
              "value": "Constancia Postman Persona4",
              "type": "text"
            },
            {
              "key": "fechaDocumento",
              "value": "2026-11-11",
              "type": "text"
            },
            {
              "key": "descripcion",
              "value": "Solo información sintética",
              "type": "text"
            },
            {
              "key": "archivo",
              "type": "file",
              "src": "postman/fixtures/documento.pdf"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201',()=>pm.response.to.have.status(201));",
              "pm.test('Respuesta JSON',()=>pm.response.to.be.json);",
              "const d=pm.response.json();pm.collectionVariables.set('documentoId',d.id);pm.collectionVariables.set('versionRegistro',String(d.versionRegistro));pm.test('Documento persistido',()=>pm.expect(d.id).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Consultar metadatos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/documentos/{{documentoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200',()=>pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON',()=>pm.response.to.be.json);",
              "pm.test('Sin clave privada',()=>pm.expect(pm.response.json()).not.to.have.property('objetoPrivado'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Descargar PDF",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/documentos/{{documentoId}}/archivo"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200',()=>pm.response.to.have.status(200));",
              "pm.test('Archivo PDF privado',()=>{pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf');pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store')});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Nueva versión del mismo documento",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/beneficiarias/{{beneficiariaId}}/documentos/cargas",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "formularioId",
              "value": "{{formularioId}}",
              "type": "text"
            },
            {
              "key": "categoria",
              "value": "Constancia Postman Persona4",
              "type": "text"
            },
            {
              "key": "fechaDocumento",
              "value": "2026-11-11",
              "type": "text"
            },
            {
              "key": "descripcion",
              "value": "Solo información sintética",
              "type": "text"
            },
            {
              "key": "documentoAnteriorId",
              "value": "{{documentoId}}",
              "type": "text"
            },
            {
              "key": "motivoCambio",
              "value": "Corrección sintética para verificar versiones",
              "type": "text"
            },
            {
              "key": "archivo",
              "type": "file",
              "src": "postman/fixtures/documento.pdf"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201',()=>pm.response.to.have.status(201));",
              "pm.test('Respuesta JSON',()=>pm.response.to.be.json);",
              "const d=pm.response.json();pm.collectionVariables.set('documentoId',d.id);pm.collectionVariables.set('versionRegistro',String(d.versionRegistro));pm.test('Documento persistido',()=>pm.expect(d.id).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Historial de versiones",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/documentos/{{documentoId}}/versiones"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200',()=>pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON',()=>pm.response.to.be.json);",
              "pm.test('Dos versiones conservadas',()=>pm.expect(pm.response.json().total).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Filtros documentales",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/beneficiarias/{{beneficiariaId}}/documentos?ultimas=true&buscar=Postman&estado=BORRADOR&pagina=1&limite=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200',()=>pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON',()=>pm.response.to.be.json);",
              "pm.test('Paginación de servidor',()=>pm.expect(pm.response.json().total).to.be.greaterThan(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Anular con motivo y versión",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/documentos/{{documentoId}}/anular",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"version\":{{versionRegistro}},\"motivo\":\"Prueba sintética de anulación\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201',()=>pm.response.to.have.status(201));",
              "pm.test('Respuesta JSON',()=>pm.response.to.be.json);",
              "pm.test('Anulación lógica',()=>pm.expect(pm.response.json().anuladoEn).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Descarga anulada bloqueada",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/documentos/{{documentoId}}/archivo"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 409',()=>pm.response.to.have.status(409));",
              "pm.test('Respuesta JSON',()=>pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Ingreso de beneficiaria",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/albergue/estancias",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"beneficiariaId\": \"{{beneficiariaAlbergueId}}\", \"ninoIds\": []}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201',()=>pm.response.to.have.status(201));",
              "pm.test('Respuesta JSON',()=>pm.response.to.be.json);",
              "pm.collectionVariables.set('estanciaId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
