              "pm.test('Contrato de cursor',()=>{const b=pm.response.json();pm.expect(b.data).to.be.an('array');pm.expect(b.page.hasMore).to.be.a('boolean');pm.expect(b).to.have.property('page');});"
            ]
          }
        }
      ]
    },
