    {
      "name": "21 Crear versión documental con motivo",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/beneficiarias/{{beneficiariaId}}/documentos/cargas",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "formularioId",
              "value": "{{socialId}}",
              "type": "text"
            },
            {
              "key": "categoria",
              "value": "Copia firmada sintética",
              "type": "text"
            },
            {
              "key": "fechaDocumento",
              "value": "2026-11-13",
              "type": "text"
            },
            {
              "key": "archivo",
              "type": "file",
              "src": "test/fixtures/documento.pdf",
              "contentType": "application/pdf"
            },
            {
              "key": "documentoAnteriorId",
              "value": "{{documentoOriginal}}",
              "type": "text"
            },
            {
              "key": "motivoCambio",
              "value": "Nueva copia sintética de ensayo",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(201));",
              "const d=pm.response.json();pm.test('Segunda versión conserva ficha',()=>{pm.expect(d.versionDocumento).to.eql(2);pm.expect(d.formularioId).to.eql(pm.collectionVariables.get('socialId'));});",
              "pm.collectionVariables.set(\"documentoId\", d.id);",
              "pm.collectionVariables.set(\"versionDocumento\", d.versionRegistro);"
            ]
          }
        }
      ]
    },
    {
      "name": "22 Historial de versiones",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/documentos/{{documentoId}}/versiones"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(200));",
              "pm.test('Dos versiones conservadas',()=>{const b=pm.response.json();pm.expect(b.total).to.eql(2);pm.expect(b.datos.every(d=>d.formularioId===pm.collectionVariables.get('socialId'))).to.eql(true);});"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Listado de documentos del área",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/beneficiarias/{{beneficiariaId}}/documentos?pagina=1&limite=20&ultimas=true"
