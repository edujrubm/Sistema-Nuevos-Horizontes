{
  "info": {
    "name": "Social — fichas ORM y PDF",
    "description": "Ensayo ordenado sobre una base local desechable con beneficiaria 100 y profesional 1. Requiere contexto técnico de Trabajo Social y coordinación para anular únicamente el PDF creado por esta colección. Crea datos sintéticos; no acredita autorización productiva. Seleccionar test/fixtures/documento.pdf en las tres cargas si Postman solicita acceso local. No incluye escrituras de hoja evolutiva.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3033/api/v1"
    },
    {
      "key": "beneficiariaId",
      "value": "100"
    },
    {
      "key": "profesionalId",
      "value": "1"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(!/^http:\\/\\/(127\\.0\\.0\\.1|localhost):\\d+\\/api\\/v1$/.test(pm.variables.get('baseUrl'))){pm.request.url.update('http://127.0.0.1:1/api/v1/ensayo-bloqueado');postman.setNextRequest(null);throw new Error('Solo se permite el laboratorio local con datos sintéticos.');}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Catálogo y estados",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tipos-formulario"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "['socialId','versionSocial','versionAnterior','documentoId','documentoOriginal','versionDocumento','descartableId','versionDescartable'].forEach(key=>pm.collectionVariables.unset(key));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(200));",
              "const body=pm.response.json(); pm.test('SOCIAL habilitado y estados disponibles',()=>{pm.expect(body.data.some(f=>f.codigo==='SOCIAL')).to.eql(true);pm.expect(body.estados.listo).to.eql(true);});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Resumen de Social",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/trabajo-social/beneficiarias/{{beneficiariaId}}/resumen"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(200));",
              "pm.test('Resumen conserva fichas, riesgos e historial',()=>{const b=pm.response.json();pm.expect(b.totalFichas).to.be.a('number');pm.expect(b.totalRiesgos).to.eql(null);pm.expect(b.historialReciente).to.be.an('array');pm.expect(b.historialReciente.length).to.be.at.most(5);});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Listado histórico con total",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/trabajo-social/beneficiarias/{{beneficiariaId}}/fichas?pagina=1&limite=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(200));",
              "pm.test('Paginación histórica',()=>{const b=pm.response.json();pm.expect(b.datos).to.be.an('array');pm.expect(b.total).to.be.a('number');pm.expect(b.pagina).to.eql(1);});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Crear borrador Social",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/beneficiarias/{{beneficiariaId}}/formularios-area",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo\": \"SOCIAL\",\n  \"fechaAtencion\": \"2026-11-13T09:00:00-06:00\",\n  \"profesionalId\": \"{{profesionalId}}\",\n  \"detalle\": {\n    \"historiaViolencia\": \"Historia sintética de ensayo\",\n    \"diagnosticoSocial\": \"Diagnóstico sintético\",\n    \"riesgosIdentificados\": \"Descripción textual sintética\",\n    \"planEliminacionRiesgos\": \"Plan sintético\",\n    \"objetivoGeneral\": \"Objetivo sintético\",\n    \"actividades\": \"Actividades sintéticas\",\n    \"evaluacion\": \"Evaluación sintética\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(201));",
              "const form=pm.response.json().data; pm.test('Ficha Social e identificadores de texto',()=>{pm.expect(form.tipo).to.eql('SOCIAL');pm.expect(form.id).to.match(/^[1-9][0-9]*$/);pm.expect(form.ninoId).to.eql(null);});",
              "pm.collectionVariables.set(\"socialId\", form.id);",
              "pm.collectionVariables.set(\"versionSocial\", form.version);",
              "pm.collectionVariables.set(\"versionAnterior\", form.version);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Consultar ficha",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/formularios-area/{{socialId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(200));",
              "pm.test('Detalle institucional persistido',()=>{const f=pm.response.json().data;pm.expect(f.id).to.eql(pm.collectionVariables.get('socialId'));pm.expect(f.detalle.historiaViolencia).to.eql('Historia sintética de ensayo');});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Guardar cambios con versión",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/formularios-area/{{socialId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"version\": {{versionSocial}},\n  \"motivo\": \"Corrección sintética en Postman\",\n  \"detalle\": {\n    \"actividades\": \"Actividades corregidas\",\n    \"dependenciaEconomica\": false\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(200));",
              "const f=pm.response.json().data;pm.test('Cambio y nueva versión',()=>{pm.expect(f.detalle.actividades).to.eql('Actividades corregidas');pm.expect(f.detalle.dependenciaEconomica).to.eql(false);pm.expect(f.version).to.be.above(Number(pm.collectionVariables.get('versionAnterior')));});",
              "pm.collectionVariables.set(\"versionSocial\", f.version);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Rechazar versión anterior",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/formularios-area/{{socialId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"version\": {{versionAnterior}},\n  \"motivo\": \"Versión anterior de ensayo\",\n  \"detalle\": {\n    \"actividades\": \"No debe sobrescribir\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(409));",
              "const error = pm.response.json();",
              "pm.test('Error público en español y solicitud identificada', () => { pm.expect(error.mensaje).to.be.a('string').and.not.empty; pm.expect(error.idSolicitud).to.match(/^SOL-/); pm.expect(error.errores).to.be.an('array'); });",
              "pm.test('Conflicto de versión específico',()=>pm.expect(error.codigo).to.eql('VERSION_DESACTUALIZADA'));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Listado común por cursor",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/beneficiarias/{{beneficiariaId}}/formularios-area?tipo=SOCIAL&limite=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
