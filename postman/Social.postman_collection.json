            ]
          }
        }
      ]
    },
    {
      "name": "24 Anulación lógica de la versión de ensayo",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/documentos/{{documentoId}}/anular",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"version\": {{versionDocumento}},\n  \"motivo\": \"Fin del ensayo documental sintético\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(201));",
              "pm.test('Anulación conserva metadatos',()=>{const d=pm.response.json();pm.expect(d.anuladoEn).not.to.eql(null);pm.expect(d.formularioId).to.eql(pm.collectionVariables.get('socialId'));});"
            ]
          }
        }
      ]
    },
    {
      "name": "25 Descarga de versión anulada rechazada",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/documentos/{{documentoId}}/archivo"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(409));",
              "const error = pm.response.json();",
              "pm.test('Error público en español y solicitud identificada', () => { pm.expect(error.mensaje).to.be.a('string').and.not.empty; pm.expect(error.idSolicitud).to.match(/^SOL-/); pm.expect(error.errores).to.be.an('array'); });",
              "pm.test('Documento anulado',()=>pm.expect(error.codigo).to.eql('DOCUMENTO_ANULADO'));"
            ]
          }
        }
      ]
    },
    {
      "name": "26 Crear borrador descartable",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/beneficiarias/{{beneficiariaId}}/formularios-area",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo\": \"SOCIAL\",\n  \"fechaAtencion\": \"2026-11-13T09:00:00-06:00\",\n  \"profesionalId\": \"{{profesionalId}}\",\n  \"detalle\": {}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(201));",
              "const f=pm.response.json().data;",
              "pm.collectionVariables.set(\"descartableId\", f.id);",
              "pm.collectionVariables.set(\"versionDescartable\", f.version);"
            ]
          }
        }
      ]
    },
