    "/beneficiarias/{id}/documentos/cargas": {
      "post": {
        "summary": "Adjuntar PDF a la ficha del área",
        "description": "Ruta documental del PDF añadida al alcance por el usuario; funcionamiento propio sin servicio externo de compañeros. Original privado, máximo 20 MiB.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "description": "bigint PostgreSQL hasta 9223372036854775807; nunca number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "archivo",
                  "formularioId",
                  "categoria"
                ],
                "properties": {
                  "archivo": {
                    "type": "string",
                    "format": "binary"
                  },
                  "formularioId": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,18}$",
                    "description": "bigint PostgreSQL hasta 9223372036854775807; nunca number"
                  },
                  "categoria": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Metadatos del documento asociado; no expone la ruta privada"
          },
          "400": {
            "description": "PDF o campos inválidos"
          },
          "403": {
            "description": "Área ajena"
          },
          "404": {
            "description": "Ficha/expediente no coinciden o niño no inscrito"
          },
          "413": {
            "description": "Más de 20 MiB"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CrearReferencia": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fechaAtencion": {
            "type": "string",
            "format": "date-time",
            "description": "Instante ISO8601 con zona horaria explícita"
          },
          "profesionalId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "description": "bigint PostgreSQL hasta 9223372036854775807; nunca number"
          },
          "detalle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "destino": {
                "type": "string",
                "maxLength": 20000,
                "nullable": true
              },
              "origen": {
                "type": "string",
                "maxLength": 20000,
                "nullable": true
              },
              "motivoReferencia": {
                "type": "string",
                "maxLength": 20000,
                "nullable": true
              },
              "recomendaciones": {
                "type": "string",
                "maxLength": 20000,
                "nullable": true
              }
            },
            "required": [],
            "description": "Opcional al crear borrador; se genera un detalle vacío cuando se omite."
          }
        },
        "required": [
          "fechaAtencion",
          "profesionalId"
        ]
      },
      "EditarReferencia": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "motivo": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "detalle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "destino": {
                "type": "string",
