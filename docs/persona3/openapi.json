    "/trabajo-social/beneficiarias/{id}/resumen": {
      "get": {
        "summary": "Resumen social",
        "description": "Ruta de persona 3 según el PDF; contrato local de la asignación.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "description": "bigint PostgreSQL hasta 9223372036854775807; nunca number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta; respuesta camelCase"
          },
          "400": {
            "description": "Entrada inválida"
          },
          "404": {
            "description": "Recurso inexistente o fuera del expediente"
          },
          "409": {
            "description": "Versión, estado o integridad incompatibles"
          },
          "503": {
            "description": "Laboratorio o catálogo no configurado"
          }
        }
      }
    },
